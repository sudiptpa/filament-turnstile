#!/usr/bin/env bash
set -euo pipefail

PHP_BIN="php"

if command -v php8.4 >/dev/null 2>&1; then
    PHP_BIN="php8.4"
elif command -v php8.3 >/dev/null 2>&1; then
    PHP_BIN="php8.3"
elif command -v php8.2 >/dev/null 2>&1; then
    PHP_BIN="php8.2"
fi

exec "$PHP_BIN" vendor/bin/phpunit --configuration phpunit.xml.dist --do-not-cache-result "$@"
