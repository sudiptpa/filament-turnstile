{
    "name": "sudiptpa/filament-turnstile",
    "description": "Cloudflare Turnstile form field for Filament v5. Protect any Filament form with a bot-resistant challenge widget.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "filament-plugin",
        "turnstile",
        "cloudflare",
        "cloudflare-turnstile",
        "captcha",
        "bot-protection",
        "laravel",
        "form-field"
    ],
    "authors": [
        {
            "name": "Sujip Thapa",
            "email": "sudiptpa@gmail.com",
            "homepage": "https://sujipthapa.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "filament/forms": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Sujip\\Filament\\Turnstile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sujip\\Filament\\Turnstile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sujip\\Filament\\Turnstile\\FilamentTurnstileServiceProvider"
            ]
        }
    },
    "scripts": {
        "stan": "bash bin/stan",
        "analyse": "@composer stan",
        "test": "bash bin/test",
        "coverage": "bash bin/coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
